      "expression": "MA(CLOSE, 70)"
    },
    {
      "id": 11,
      "name": "MA80",
      "description": "80日均线",
      "formulaType": "EXPRESSION",
      "expression": "MA(CLOSE, 80)"
    },
    {
      "id": 12,
      "name": "MFI14",
      "description": "Money Flow Index 14",
      "formulaType": "EXPRESSION",
      "expression": "100-(100/(1+SUM(IF(((HIGH+LOW+CLOSE)/3)>REF((HIGH+LOW+CLOSE)/3,1),((HIGH+LOW+CLOSE)/3)*VOL,0),14)/SUM(IF(((HIGH+LOW+CLOSE)/3)<REF((HIGH+LOW+CLOSE)/3,1),((HIGH+LOW+CLOSE)/3)*VOL,0),14)))"
    }
  ],
  "security": {
    "enableTimeLimit": false
  }
}
