      "expression": "MA(CLOSE, 30)"
    },
    {
      "id": 7,
      "name": "MA40",
      "description": "40日均线",
      "formulaType": "EXPRESSION",
      "expression": "MA(CLOSE, 40)"
    },
    {
      "id": 8,
      "name": "MA50",
      "description": "50日均线",
      "formulaType": "EXPRESSION",
