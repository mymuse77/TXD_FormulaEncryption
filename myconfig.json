{
  "pluginName": "MyTest",
  "pluginDescription": "我的交易策略",
  "functions": [
    {
      "id": 1,
      "name": "GoldenCross",
      "description": "金叉信号",
      "formulaType": "EXPRESSION",
      "expression": "CROSS(MA(CLOSE, 5), MA(CLOSE, 10))"
    },
    {
      "id": 2,
      "name": "BollingerUpper",
      "description": "布林带上轨",
      "formulaType": "EXPRESSION",
      "expression": "MA(CLOSE, 20) + STD(CLOSE, 20) * 2"
    },
    {
      "id": 3,
      "name": "PriceMomentum",
      "description": "价格动量",
      "formulaType": "EXPRESSION",
      "expression": "(CLOSE - REF(CLOSE, 10)) / REF(CLOSE, 10) * 100"
    },
    {
      "id": 4,
      "name": "MA10",
      "description": "10日均线",
      "formulaType": "EXPRESSION",
      "expression": "MA(CLOSE, 10)"
    },
    {
      "id": 5,
      "name": "MA20",
      "description": "20日均线",
      "formulaType": "EXPRESSION",
      "expression": "MA(CLOSE, 20)"
    },
    {
      "id": 6,
      "name": "MA30",
      "description": "30日均线",
